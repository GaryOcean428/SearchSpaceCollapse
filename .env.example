# SearchSpaceCollapse Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Optional - uses file storage if not set)
# DATABASE_URL=postgresql://user:pass@localhost:5432/searchspace

# Redis Cache (Optional - uses in-memory cache if not set)
# Recommended for production deployments
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Ocean Agent Configuration
MAX_ITERATIONS=1000

# UI Configuration
# Bitcoin to USD conversion rate (used for balance display)
# If not set, defaults to $50,000
VITE_BTC_USD_RATE=50000

# External APIs
# Tavily API for Zeus Chat web search (optional)
# Get your key at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Darknet Configuration (optional - for stealth operations)
# Enable Tor routing for blockchain queries
# Requires Tor to be running locally (default: 127.0.0.1:9050)
ENABLE_TOR=false
TOR_PROXY=socks5h://127.0.0.1:9050
# Optional: HTTP proxy as alternative to Tor
HTTP_PROXY=
HTTPS_PROXY=

# Security (for production)
# SESSION_SECRET=your-session-secret-here
# ENABLE_HTTPS=true

# Replit Authentication (Required for auth to work)
# SESSION_SECRET: Random 32+ character string for session encryption
# Generate with: openssl rand -base64 32
# MUST be set in Replit Secrets for authentication to work
SESSION_SECRET=

# REPL_ID: Automatically set by Replit (your app's client ID)
# Do not set manually - Replit provides this automatically
# REPL_ID=

# Auth Configuration (Optional - uses defaults if not set)
# ISSUER_URL: OAuth issuer URL (default: https://replit.com/oidc)
# ISSUER_URL=https://replit.com/oidc

# REDIRECT_URI_BASE: Base URL for OAuth callbacks (default: dynamic from request)
# Set this if you need strict redirect URI matching for your deployed domain
# Example: https://your-app.replit.app
# REDIRECT_URI_BASE=

# AUTH_SCOPES: OAuth scopes to request (space-separated)
# Default: openid email profile offline_access
# AUTH_SCOPES=openid email profile offline_access

# SESSION_TTL: Session lifetime in milliseconds (default: 604800000 = 7 days)
# SESSION_TTL=604800000

# TOKEN_REFRESH_BUFFER: Seconds before token expiry to trigger refresh (default: 300 = 5 minutes)
# TOKEN_REFRESH_BUFFER=300

# AUTH_MAX_RETRIES: Max retries for token refresh (default: 3)
# AUTH_MAX_RETRIES=3

# AUTH_RETRY_BACKOFF: Initial retry backoff in ms (default: 1000)
# Subsequent retries use exponential backoff
# AUTH_RETRY_BACKOFF=1000
